# Copy into environment settings or an untracked .env.local. Never commit real values.
# Required for LIVE operator + invited customer access (demo works independently).
PORT67_SESSION_SECRET=
PORT67_OPERATOR_PASSWORD=
# Canonical public origin behind a reverse proxy, e.g. https://port67.ai
PORT67_PUBLIC_ORIGIN=
# Enable only when hosting overwrites incoming forwarding headers.
PORT67_TRUST_PROXY=false
# Keep true for an isolated, synthetic, visitor-specific demo at /portal.
PORT67_DEMO_ENABLED=true
# Local persistence: single Node process, persistent private disk required.
PORT67_STORAGE=local
PORT67_DATA_DIR=/var/data/port67-factory
PORT67_DEMO_DATA_DIR=/var/data/port67-demo
# Optional dedicated Factory Firebase server adapter. Never select the legacy project by accident.
PORT67_FIREBASE_PROJECT_ID=
PORT67_FIREBASE_DATABASE=(default)
PORT67_FIREBASE_SERVICE_ACCOUNT=
# Optional bounded live research. No model calls unless all three are configured.
PORT67_RESEARCH_ENABLED=false
PORT67_OPENAI_API_KEY=
PORT67_RESEARCH_MODEL=
PORT67_MAX_RESEARCH_RUNS=12
