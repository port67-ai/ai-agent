rules_version = '2';
// Prototype: dedicated Factory project only. Accounts contain owner UID/private
// contact; projects contain research, briefs and assets; system documents hold
// private directory/cost records. All browser SDK access is denied, even signed in.
// Only IAM-authorised Admin SDK requests bypass these rules. Server validation
// in accounts/engine/service is therefore required for every create/update/read.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
